rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users can read/write their own document
    match /users/{userId} {
      allow read, write: if isAuthenticated() && request.auth.uid == userId;
    }

    // Organizations
    match /organizations/{orgId} {
      allow read: if true; // Public can read to render /r/[slug]
      allow create, update: if isAuthenticated();
    }

    // Organization Members
    match /organization_members/{memberId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAuthenticated();
    }

    // Review Clicks
    match /review_clicks/{clickId} {
      allow create: if true; // Public can log a click
      allow read, update, delete: if isAuthenticated();
    }

    // Customers
    match /customers/{customerId} {
      allow create, read, update, delete: if isAuthenticated();
    }

    // Transactions
    match /transactions/{transactionId} {
      allow create, read, update, delete: if isAuthenticated();
    }
  }
}
